[Unit]
Description=DGX Spark digital photoframe
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/dgx-spark-photoframe
ExecStart=/bin/bash ./scripts/start-photoframe.sh
ExecStop=/usr/bin/docker compose stop
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
