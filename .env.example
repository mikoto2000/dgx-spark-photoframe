# 写真ディレクトリ（コンテナでは /photos、読み取り専用）。
PHOTO_DIR=/home/mikoto/photos

# 永続 DRM device パス。実際の値は ls -l /dev/dri/by-path/ で確認。
# 下記はサンプル。platform-...-card または pci-...-card に変更する。
DRM_DEVICE=/dev/dri/by-path/platform-xxxxxxxx.display-card

# auto は対象 device の connected connector を自動解決。
# Unknown-4 等の明示指定も利用可能。
DRM_CONNECTOR=auto

# 任意。複数モニタ時には対象の EDID SHA-256 を設定。
# 確認方法は README の DRM Connector を参照。
#   for f in /sys/class/drm/card*-*/edid; do
#     hash=$(cat "$f" | sha256sum) || continue
#     hash=${hash%% *}
#     [ "$hash" = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 ] || echo "$hash $f"
#   done
DRM_MONITOR_EDID_SHA256=

# 表示時間（秒）。
PHOTO_DURATION=15
# 回転角度: 0 / 90 / 180 / 270。
PHOTO_ROTATE=0
